<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1><%= title %></h1>
    <h2>Jelenlegi foglalások száma: <%= foglalasokSzama %></h2>

    <form method="post">
        <label for="name">Name:</label>
        <input type="text" name="name" id="name" required>
        <label for="email">Email:</label>
        <input type="text" name="email" id="email" required>
        <label for="startDate">Dátum:</label>
        <input type="datetime-local" name="startDate" id="startDate" required>
        <label for="guests">Létszám (1-10):</label>
        <input type="number" name="guests" id="guests" required>
        <button type="submit">Submit</button>
    </form>

    <p>
        <% if (locals.errors) { %>
            <% locals.errors.forEach(error => { %>
                <%= error %> <br>
            <% }) %>
        <% } %>
        <% if (locals.success) { %>
            <%= locals.success %>
        <% } %>
    </p>
</body>
</html>